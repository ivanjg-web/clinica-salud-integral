{
  "openapi": "3.0.0",
  "info": {
    "title": "API Clínica Salud Integral",
    "version": "1.0.0",
    "description": "Documentación de la API para la gestión de una clínica médica"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Servidor local"
    }
  ],
  "paths": {
    "/api/specialties/": {
      "get": {
        "tags": [
          "Especialidades"
        ],
        "summary": "Listar especialidades médicas",
        "description": "Obtiene el listado de todas las especialidades médicas registradas en la clínica.",
        "responses": {
          "200": {
            "description": "OK"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/patients/": {
      "get": {
        "tags": [
          "Pacientes"
        ],
        "summary": "Listar pacientes",
        "description": "Obtiene el listado de pacientes registrados en la clínica. Requiere autenticación JWT y rol RECEPCIONISTA.",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "post": {
        "tags": [
          "Pacientes"
        ],
        "summary": "Registrar paciente",
        "description": "Registra un nuevo paciente en la clínica después de validar los datos enviados. Requiere autenticación JWT y rol RECEPCIONISTA.",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "example": "any"
                  },
                  "email": {
                    "example": "any"
                  },
                  "birthDate": {
                    "example": "any"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/patients/{id}": {
      "get": {
        "tags": [
          "Pacientes"
        ],
        "summary": "Consultar paciente por ID",
        "description": "Obtiene la información de un paciente específico mediante su identificador. Requiere autenticación JWT y rol RECEPCIONISTA.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/doctors/": {
      "get": {
        "tags": [
          "Médicos"
        ],
        "summary": "Listar médicos",
        "description": "Obtiene el listado de médicos registrados en la clínica, incluyendo su información profesional. Requiere autenticación JWT y rol RECEPCIONISTA.",
        "parameters": [
          {
            "name": "specialty",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/doctors/{id}": {
      "get": {
        "tags": [
          "Médicos"
        ],
        "summary": "Consultar médico por ID",
        "description": "Obtiene la información de un médico específico mediante su identificador. Requiere autenticación JWT y rol RECEPCIONISTA.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/doctors/{id}/appointments": {
      "get": {
        "tags": [
          "Médicos"
        ],
        "summary": "Consultar agenda médica",
        "description": "Obtiene las citas asignadas al médico indicado, permitiendo consultar su agenda según los filtros disponibles. El médico autenticado únicamente puede consultar su propia agenda.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": [
          "Autenticación"
        ],
        "summary": "Registrar un usuario",
        "description": "Permite a GERENCIA registrar usuarios. Requiere autenticación JWT. Para usuarios MEDICO, doctorId es obligatorio y debe corresponder a un médico existente.",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Usuario registrado correctamente"
          },
          "400": {
            "description": "Datos inválidos o referencia al médico no válida"
          },
          "401": {
            "description": "Token no proporcionado o inválido"
          },
          "403": {
            "description": "No tienes permiso para registrar usuarios"
          },
          "404": {
            "description": "El médico indicado no existe"
          },
          "409": {
            "description": "Correo electrónico ya registrado"
          },
          "500": {
            "description": "Error al registrar el usuario"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password",
                  "role"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "medico@clinica.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "123456"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "RECEPCIONISTA",
                      "MEDICO",
                      "GERENCIA"
                    ],
                    "example": "MEDICO"
                  },
                  "doctorId": {
                    "type": "integer",
                    "example": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Autenticación"
        ],
        "summary": "Iniciar sesión",
        "description": "Autentica un usuario y devuelve un token JWT.",
        "responses": {
          "200": {
            "description": "Inicio de sesión exitoso"
          },
          "401": {
            "description": "Credenciales inválidas"
          },
          "500": {
            "description": "Error al iniciar sesión"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "medico@clinica.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "123456"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/appointments/": {
      "post": {
        "tags": [
          "Citas"
        ],
        "summary": "Registrar una cita médica",
        "description": "Crea una nueva cita médica asociando un paciente con un médico y una fecha de atención. Requiere autenticación JWT y rol RECEPCIONISTA.",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "patientId": {
                    "example": "any"
                  },
                  "doctorId": {
                    "example": "any"
                  },
                  "scheduledAt": {
                    "example": "any"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/appointments/{id}/status": {
      "patch": {
        "tags": [
          "Citas"
        ],
        "summary": "Actualizar estado de una cita",
        "description": "Permite actualizar el estado de una cita médica. Requiere autenticación JWT y rol MEDICO.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": {
                    "example": "any"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/reports/appointments-by-specialty": {
      "get": {
        "tags": [
          "Reportes"
        ],
        "summary": "Consultar citas por especialidad",
        "description": "Genera un reporte con la cantidad de citas agrupadas por especialidad médica. Disponible únicamente para usuarios con rol GERENCIA.",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/reports/daily-cutoff": {
      "get": {
        "tags": [
          "Reportes"
        ],
        "summary": "Consultar corte diario",
        "description": "Genera un resumen de las citas correspondientes a una fecha específica, agrupadas según su estado. Requiere autenticación JWT y rol GERENCIA.",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}